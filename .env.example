GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_RPM=8

# Trilhas de estudo (python -m trilhas.gerar). Groq hospeda modelos abertos; sem chave, as trilhas saem por regras.
# Crie a chave em https://console.groq.com/keys. Modelos e limites mudam: https://console.groq.com/docs/models
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Login do portal (Supabase > Project Settings > API). A chave anon/publishable é pública por design.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Opcional: provedores OAuth habilitados no Supabase, separados por vírgula (github,google)
AUTH_PROVEDORES=

# API FastAPI (apps/api). Origens do front autorizadas no CORS, separadas por vírgula.
# API_ORIGENS_PERMITIDAS=http://localhost:3000
# Só para projetos Supabase antigos (JWT HS256). Projetos novos usam JWKS e não precisam disto.
# SUPABASE_JWT_SECRET=

# Política de privacidade (#/privacidade). Vazios aparecem como "[a definir]" na página.
# Quem responde pelos dados (pessoa ou organização) e e-mail para pedidos da LGPD.
PRIVACIDADE_RESPONSAVEL=
PRIVACIDADE_CONTATO=
# Região do projeto Supabase (Project Settings > General), ex.: "São Paulo (sa-east-1)".
PRIVACIDADE_REGIAO_DADOS=

# SÓ DESENVOLVIMENTO: abre o site como uma pessoa logada de teste (sem Supabase). Ignorada em produção. Nunca publique com isto.
# NEXT_PUBLIC_CONTA_FAKE=1
